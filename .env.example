# 复制为 .env 并填入（本项目不自动读取 .env，请用 shell 导出或 docker -e 传入）

# ---- 模型 ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- ASR（可选；不配就走元宝总结，配了才能升到「原声转录」）----
# ASR_BACKEND: auto | deepseek | openai | local
#   auto     base_url 指向 deepseek.com 就用 DeepSeek /tools/asr，否则用 OpenAI 兼容端点
#   deepseek POST {base}/v1/tools/asr —— 只收 16bit PCM WAV / Ogg Opus，≤8MiB、≤120s
#   openai   POST {base}/audio/transcriptions
#   local    本机 whisper CLI
ASR_BACKEND=auto
ASR_BASE_URL=https://api.deepseek.com
# 留空则复用 LLM_API_KEY（DeepSeek 的模型与工具同一个账号）
ASR_API_KEY=
# 下面三项仅 openai / local 生效；DeepSeek ASR 不收 model/language/prompt
ASR_MODEL=
ASR_LANGUAGE=zh
ASR_PROMPT=

# 转录后处理（DeepSeek ASR 没有 prompt 参数，只能事后修）
# 1) 确定性规则替换，零成本，格式 "错=对;错=对"
ASR_FIX=
# 2) 让模型校对同音字/数字误识，一次额外调用；只修错字，不许改写
ASR_PROOFREAD=off

# ---- 抓取 ----
# FETCH_BACKEND: auto | deepseek | local
#   auto      本地解析优先，失败才回退 DeepSeek Fetch（保住作者/时间解析）
#   deepseek  DeepSeek Fetch 优先，失败回退本地（面对强反爬更省事）
#   local     只用本地抓取
FETCH_BACKEND=auto
DFS_API_KEY=
DFS_BASE_URL=https://api.deepseek.com

# ---- 外部溯源（Search）----
# 对判定为「未核」的条目自动检索一次，有高权威证据才升级为「确证」
SEARCH_ENABLED=auto      # auto | off
SEARCH_COUNT=6           # 每次检索取几条（1-50）
SEARCH_MAX_ITEMS=3       # 最多溯源几项（控制成本）

# ---- 服务（命令行参数优先：python3 server/app.py -p 8123）----
PORT=8000
HOST=0.0.0.0
# 每 IP 每小时次数
RATE_LIMIT_PER_HOUR=10
# 限流后端：留空 = 进程内存（单机开发）；填 redis:// 地址 = Redis（多副本部署）
# 注意「没配」是模式、「连不上」是故障 —— 后者 fail closed 回 503，不回退内存
REDIS_URL=
# 反代后取真实 IP：只有直连 peer 落在名单里才采信 X-Real-IP / X-Forwarded-For
# 支持逗号分隔的 IP 与网段；**留空 = 不信任任何代理头**（安全默认）
# 多副本 + nginx 部署时必须填，否则全站被算成同一个 IP（额度共用）
TRUSTED_PROXIES=
# 限流键的盐：Redis 里的键是 sha256(盐+IP) 前 32 位，不留明文地址。
# 换盐 = 旧键全部作废，效果等同「全员额度重置」，按需轮换。
RL_SALT=deepread-v1
# 单个上传文件上限（MB）
MAX_UPLOAD_MB=300
# 上传件保留小时数：分析结束会立刻删，这条是兜底（上传后没点「开始读解」的）
UPLOAD_TTL_HOURS=24
# 同时进行的任务上限。读解一次要跑 1–2 分钟，线程无上限时高峰会拖垮整机
MAX_CONCURRENT=8
# 等额度的秒数；等不到直接 503，不做无上限排队（否则空线程会堆满）
SLOT_WAIT_SEC=20
